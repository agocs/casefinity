# Original Fusion 360 sources — the Unemployed Architect's Patreon-distributed
# designs. Kept locally as reverse-engineering reference, never redistributed
# here. The STEP exports in hardcase-gridfinity-generator/ground-truth/ are the
# tracked ground truth. See README "Design provenance".
*.f3d
1. Template/
2. Perimeter/
3. Bins/

# Superseded by hardcase-gridfinity-generator/ground-truth/, which
# aps_f3d_to_step.py now writes to directly.
step_output/

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.vite/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets — aps_f3d_to_step.py reads APS_CLIENT_ID / APS_CLIENT_SECRET from
# the environment. Never commit them.
.env
.env.*
!.env.example

# Cloudflare / Wrangler
.wrangler/

