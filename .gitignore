# Original Fusion 360 sources — the Unemployed Architect's designs, kept locally
# as reverse-engineering reference. Untracked because nothing in the build reads
# them and they are large opaque binaries, not for licensing reasons: Casefinity
# has his written permission. The STEP exports in
# hardcase-gridfinity-generator/ground-truth/ are the tracked ground truth.
*.f3d
1. Template/
2. Perimeter/
3. Bins/

# Superseded by hardcase-gridfinity-generator/ground-truth/, which
# aps_f3d_to_step.py now writes to directly.
step_output/

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.vite/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets — aps_f3d_to_step.py reads APS_CLIENT_ID / APS_CLIENT_SECRET from
# the environment. Never commit them.
.env
.env.*
!.env.example

# Cloudflare / Wrangler
.wrangler/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Local scratch output from the analysis scripts (depth-map PNGs, exported
# meshes). Regenerate with scripts/render-mesh.mjs.
*.local.*
/scratch/
